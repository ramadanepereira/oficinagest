{
  "name": "oficinagest-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do OficinaGest — Gestão de Inventário para Oficinas",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "migrar": "node-pg-migrate up -m migrations -d DATABASE_URL",
    "migrar:desfazer": "node-pg-migrate down -m migrations -d DATABASE_URL --count 1",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "vitest run",
    "test:integracao": "vitest run --config vitest.config.integracao.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "supertest": "^7.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  }
}